		font-size: 12px;
	}
	.topbar nav a {
		text-decoration: none;
	}
	.tag {
		font: 11px var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 18px 25px;
		font-size: 14px;
		font-weight: 650;
		text-decoration: none;
		border-radius: 4px;
	}
	.bottom {
		padding: 35px 0;
