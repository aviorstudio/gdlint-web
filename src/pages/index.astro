		.card-grid {
			grid-template-columns: 1fr;
		}
		main > section {
			margin-bottom: 70px;
		}
	}
	@media (max-width: 600px) {
		.folio {
			width: calc(100% - 36px);
		}
		.topbar {
			min-height: 85px;
			gap: 16px;
			flex-wrap: wrap;
			padding: 20px 0;
		}
		.topbar nav {
			gap: 16px;
			font-size: 11px;
		}
		.wordmark {
			font-size: 21px;
		}
		.bottom {
			flex-wrap: wrap;
		}
		.cta {
			padding: 16px 20px;
		}
		th,
		td {
			padding: 12px 7px;
			font-size: 11px;
		}
		main > section {
			margin-bottom: 55px;
		}
	}
	.review-cover {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 70px;
		align-items: center;
		padding-top: 45px;
	}
	.review-cover h1 {
		font-family: var(--mono);
		font-family: var(--mono);
		font-size: clamp(45px, 4.9vw, 68px);
		line-height: 1.02;
		letter-spacing: -0.055em;
		font-weight: 550;
		margin: 30px 0;
	}
	.review-cover h1 em {
		font-family: var(--mono);
		font-style: normal;
		font-weight: 550;
		color: #4f7755;
	}
	.review-cover > div:first-child > p:not(.tag) {
		font-size: 18px;
		color: #667c65;
		max-width: 420px;
	}
	.cta {
		background: #346349;
		color: #fff;
	}
	.install-command {
		display: block;
		font-size: 10px;
		line-height: 1.7;
		overflow-wrap: anywhere;
		color: #667c65;
		margin-top: 25px;
	}
	.tag {
		color: #507451;
	}
	.review-board {
		background: #fff;
		border: 1px solid #b8cbb6;
		border-radius: 7px;
		box-shadow: 0 20px 40px #35522c10;
	}
	.review-header {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		font: 9px var(--mono);
		color: #667c65;
		padding: 22px;
		border-bottom: 1px solid #dce7d7;
	}
	.code-review {
