---
import Full from '../layouts/Full.astro';

const repo = 'https://github.com/aviorstudio/gdlint';
const releases = 'https://github.com/aviorstudio/gdlint/releases';

// Every rule the tool has, with the default it actually ships. `on` is taken
// from NewDefaultConfig in src/models/config.go: four checks are on in a fresh
// project and everything else waits to be asked for. The table is the honest
// version of a feature list -- it says what is off as loudly as what is on.
const rules = [
	{ key: 'print_statements', kind: 'error', on: true, catches: 'print() and debug output left behind' },
	{ key: 'pass_statements', kind: 'error', on: true, catches: 'pass in a body that already has statements' },
	{ key: 'orphaned_uids', kind: 'error', on: true, catches: 'a .gd.uid whose script is gone' },
	{ key: 'indentation', kind: 'error', on: true, catches: 'spaces where GDScript indents with tabs' },
	{ key: 'unused_functions', kind: 'error', on: false, catches: 'functions nothing calls' },
	{ key: 'unused_signals', kind: 'error', on: false, catches: 'signals nothing connects or emits' },
	{ key: 'unused_constants', kind: 'error', on: false, catches: 'constants nothing reads' },
	{ key: 'unused_enums', kind: 'error', on: false, catches: 'enums and enum values nothing reads' },
	{ key: 'unused_class_names', kind: 'error', on: false, catches: 'class_name nothing refers to' },
	{ key: 'unused_files', kind: 'error', on: false, catches: 'scripts no script, scene or autoload points at' },
	{ key: 'comments', kind: 'error', on: false, catches: 'comments outside the allowed prefixes' },
	{ key: 'has_method', kind: 'error', on: false, catches: 'dynamic dispatch instead of a typed call' },
	{ key: 'variant_usage', kind: 'error', on: false, catches: 'explicit Variant in a signature' },
	{ key: 'missing_return_types', kind: 'error', on: false, catches: 'public functions with no return annotation' },
	{ key: 'single_use_functions', kind: 'warning', on: false, catches: 'functions with exactly one caller' },
	{ key: 'empty_functions', kind: 'warning', on: false, catches: 'functions with nothing in them' },
];
---

<Full>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				gdlint
			</a>
			<nav aria-label="Main">
				<a href="#rules">Rulebook</a>
				<a href="https://github.com/aviorstudio/gdlint">GitHub ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="review-cover">
				<div>
					<p class="tag">GDSCRIPT / PROJECT HYGIENE</p>
					<h1>
						A cleaner
						<br />
						<em>next commit.</em>
					</h1>
					<p>
						Catch the debug prints, stray <code>pass</code> statements, orphaned UIDs and indentation issues before they
						become the leftovers.
					</p>
					<a class="cta" href={releases}>
						Get gdlint ↗
					</a>
					<code class="install-command">go install github.com/aviorstudio/gdlint@latest</code>
				</div>
				<div class="review-board">
					<div class="review-header">
						<span>REVIEW / EXAMPLE.GD</span>
						<span>GODOT 4</span>
					</div>
					<div class="code-review">
						<div class="code-lines">
							<span>1</span>
							<span>2</span>
							<span>3</span>
							<span>4</span>
						</div>
						<pre><span class="syntax">func</span> _ready() -&gt; <span class="syntax">void</span>:
<span class="highlight">    print("debug: ready")</span>
    start_game()
</pre>
					</div>
					<div class="diagnostic">
						<span class="diagnostic-dot">!</span>
						<div>
							<b>Debug print found</b>
							<p>
								<code>print_statements</code> · enabled by default
							</p>
						</div>
					</div>
					<div class="review-status">
						<span>CHECK THE PROJECT</span>
						<code>$ gdlint</code>
						<span>→ REVIEW THE REPORT</span>
					</div>
					<p class="review-caption">
						Illustrative check. Review the report before using <code>-fix</code>.
					</p>
				</div>
			</section>
			<section class="default-rules">
				<div>
					<p class="tag">SENSIBLE FIRST CHECKS</p>
					<h2 class="section-heading">
						Four on.
						<br />
						The rest, your call.
					</h2>
					<p>
						A fresh project gets four checks. Enable the deeper unused-code and typing rules when they fit your
						conventions.
					</p>
				</div>
				<div class="defaults">
					{rules
						.filter((rule) => rule.on)
						.map((rule, index) => (
							<article>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<div>
									<b>{rule.key}</b>
									<p>{rule.catches}</p>
								</div>
								<i>✓</i>
							</article>
						))}
				</div>
			</section>
			<section class="rules" id="rules">
				<div class="section-head">
					<p class="eyebrow">
						<span></span> gdlint init
					</p>
					<h2>Every rule, and what it ships as.</h2>
					<p>
						<code>gdlint init</code> writes this list into <code>gdlint.json</code> with the defaults below. Errors
						block and exit non-zero; warnings only appear under <code>-warn</code>. Files can be excluded wholesale, or
						only from the unused-code rules, or only from the Variant rule.
					</p>
					<p class="aside">
						<code>-fix</code> acts on the errors — it deletes functions, signals, constants and whole files that static
						analysis believes are unused. Reflection, a string-built
						<code>call()</code> or a resource path assembled at runtime is invisible to it. Turn the unused rules on,
						read what they report, and keep the change reviewable.
					</p>
				</div>

				<table>
					<thead>
						<tr>
							<th scope="col">Rule</th>
							<th scope="col">Catches</th>
							<th scope="col">Default</th>
						</tr>
					</thead>
					<tbody>
						{rules.map((rule) => (
							<tr>
								<th scope="row">
									<code>{rule.key}</code>
									{rule.kind === 'warning' && <i>warning</i>}
								</th>
								<td>{rule.catches}</td>
								<td class={rule.on ? 'on' : 'off'}>{rule.on ? 'on' : 'off'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
			<section class="review-close">
				<div>
					<p class="tag">KEEP THE CHANGE REVIEWABLE</p>
					<h2 class="section-heading">
						Make room for
						<br />
						what your game needs.
					</h2>
				</div>
				<div>
					<p>
						A single binary for Linux, macOS and Windows. Run a check locally or use it to keep your project honest in
						CI.
					</p>
					<a class="cta" href={repo}>
						Read the guide ↗
					</a>
				</div>
			</section>
		</main>
		<footer class="bottom">
			<span>gdlint / by Avior Studio</span>
			<nav aria-label="Footer">
				<a href="https://github.com/aviorstudio/gdlint">Source</a>
				<a href="https://github.com/aviorstudio/gdlint/releases">Releases</a>
			</nav>
		</footer>
	</div>
</Full>
<style>
	* {
		box-sizing: border-box;
	}
	a {
		color: inherit;
		text-underline-offset: 5px;
	}
	img {
		max-width: 100%;
	}
	svg {
		max-width: 100%;
	}
	h1,
	h2,
	h3,
	p {
		overflow-wrap: break-word;
	}
	h1,
	h2,
	h3 {
		text-wrap: balance;
	}
	p {
		line-height: 1.7;
	}
