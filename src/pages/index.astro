		cursor: pointer;
		padding: 20px 0;
		font-size: 16px;
	}
	details {
		border-top: 1px solid var(--line);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}
	th,
	td {
		text-align: left;
		padding: 15px;
		border-bottom: 1px solid var(--line);
		overflow-wrap: anywhere;
	}
	th {
		font-weight: 600;
	}
	main > section {
		margin-bottom: 100px;
	}
	.source-label {
		font: 10px var(--mono);
		letter-spacing: 0.06em;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 5px;
	}
