		font-weight: 550;
	}
	.diagnostic p {
		font-size: 10px;
		color: #a1814b;
		margin: 8px 0 0;
	}
	.review-status {
		padding: 20px 25px;
		border-top: 1px solid #dce7d7;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 18px;
		font: 8px var(--mono);
		color: #667c65;
	}
