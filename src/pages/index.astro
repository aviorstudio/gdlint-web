		gap: 25px;
	}
	.card-grid h3 {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.card-grid p {
		font-size: 14px;
	}
	.icon svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
