---
import Full from '../layouts/Full.astro';
import octicons from '@primer/octicons';

const repo = 'https://github.com/aviorstudio/gdlint';
const releases = 'https://github.com/aviorstudio/gdlint/releases';
const icon = (name: keyof typeof octicons, size = 16) =>
	octicons[name].toSVG({ width: size, height: size });

// Every rule the tool has, with the default it actually ships. `on` is taken
// from NewDefaultConfig in src/models/config.go: four checks are on in a fresh
// project and everything else waits to be asked for. The table is the honest
// version of a feature list -- it says what is off as loudly as what is on.
const rules = [
	{ key: 'print_statements', kind: 'error', on: true, catches: 'print() and debug output left behind' },
	{ key: 'pass_statements', kind: 'error', on: true, catches: 'pass in a body that already has statements' },
	{ key: 'orphaned_uids', kind: 'error', on: true, catches: 'a .gd.uid whose script is gone' },
	{ key: 'indentation', kind: 'error', on: true, catches: 'spaces where GDScript indents with tabs' },
	{ key: 'unused_functions', kind: 'error', on: false, catches: 'functions nothing calls' },
	{ key: 'unused_signals', kind: 'error', on: false, catches: 'signals nothing connects or emits' },
	{ key: 'unused_constants', kind: 'error', on: false, catches: 'constants nothing reads' },
	{ key: 'unused_enums', kind: 'error', on: false, catches: 'enums and enum values nothing reads' },
	{ key: 'unused_class_names', kind: 'error', on: false, catches: 'class_name nothing refers to' },
	{ key: 'unused_files', kind: 'error', on: false, catches: 'scripts no script, scene or autoload points at' },
	{ key: 'comments', kind: 'error', on: false, catches: 'comments outside the allowed prefixes' },
	{ key: 'has_method', kind: 'error', on: false, catches: 'dynamic dispatch instead of a typed call' },
	{ key: 'variant_usage', kind: 'error', on: false, catches: 'explicit Variant in a signature' },
	{ key: 'missing_return_types', kind: 'error', on: false, catches: 'public functions with no return annotation' },
	{ key: 'single_use_functions', kind: 'warning', on: false, catches: 'functions with exactly one caller' },
	{ key: 'empty_functions', kind: 'warning', on: false, catches: 'functions with nothing in them' },
];
---

<Full>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="/" aria-label="gdlint home">
				<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
					<path d="M16 3 28 10v12L16 29 4 22V10L16 3Z"></path>
					<path d="m10.5 16.5 3.5 3.5 7.5-8"></path>
				</svg>
				<span>gdlint</span>
			</a>
			<a class="header-cta" href={repo}>GitHub <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Godot · GDScript</p>
					<h1>Dead code, <em>found and gone.</em></h1>
					<p class="lede">
						gdlint reads every script in your Godot project — and every scene and autoload entry
						that could be pointing at one — then tells you what nothing references. Leftover
						prints, orphaned <code>.gd.uid</code> files and dynamic <code>has_method()</code>
						calls too. Run it with <code>-fix</code> and it takes them out.
					</p>
					<div class="hero-actions">
						<code class="install">go install github.com/aviorstudio/gdlint@latest</code>
						<p>Go · one static binary · Linux, macOS and Windows</p>
					</div>
				</div>

				<div class="product-frame" aria-label="gdlint output on a Godot project">
					<div class="frame-bar">
						<div class="frame-brand"><span class="menu-lines"></span> gdlint / godot_client</div>
						<div class="frame-actions"><span class="icon" set:html={icon('checklist', 13)} /><span class="icon" set:html={icon('terminal', 13)} /></div>
					</div>
					<div class="term">
						<pre><span class="cmd">$ gdlint</span>
<span class="head-err">=== ERRORS (will be removed with -fix) ===</span>

<span class="err">Unused files:</span> 3
  <span class="loc">• addon/autoload.gd</span>
  <span class="loc">• addon/plugin.gd</span>
  <span class="loc">• addon/src/core/router.gd</span>

<span class="err">Print statements:</span> 1
  <span class="loc">• addon/plugin.gd:59: print("GD Router: Created route map at %s." % RouteMapGenera...</span>

<span class="err">Orphaned UID files:</span> 2
  <span class="loc">• addon/src/route_transition_util.gd.uid</span>
  <span class="loc">• addon/src/router_service.gd.uid</span>

<span class="head-err">❌ has_method() calls (ALWAYS ERRORS):</span> 2
  <span class="err">• addon/src/core/router.gd:121: if not route.guard.has_method("can_enter"):</span>
  <span class="err">• addon/src/core/router.gd:131: if not host.has_method("mount_route"):</span>

<span class="err">Explicit Variant usages (disallowed once enabled):</span> 1
  <span class="loc">• addon/src/core/router.gd:99: func get_param(key: String, default: Variant = null) -&gt; Vari...</span>

<span class="head-sum">=== SUMMARY ===</span>
<span class="err">❌ 9 errors found</span>
   Run with <b>-fix</b> to remove all errors</pre>
					</div>
					<div class="frame-keys"><span>exit 1</span> errors block<i></i><span>-warn</span> adds the warnings<i></i><span>-fix</span> removes the errors</div>
				</div>
			</section>

			<section class="principles" aria-label="How gdlint works">
				<article>
					<span class="number">01</span>
					<div>
						<h2>It knows what it is not</h2>
						<p>
							gdlint has no opinion on your directory names, your required sibling files, which
							layer may import which, or who owns an autoload. Those rules are yours and they
							change per project — a hygiene checker that guessed at them would be wrong in every
							repo but the one it was written in.
						</p>
					</div>
				</article>
				<article>
					<span class="number">02</span>
					<div>
						<h2>Unused means nothing points at it</h2>
						<p>
							Before a script is called dead, gdlint follows <code>preload</code>, <code>load</code>
							and file-path <code>extends</code> through every <code>.gd</code>, the
							<code>ext_resource</code> and <code>script</code> paths inside every
							<code>.tscn</code>, and the autoload list in <code>project.godot</code>. A scene
							referencing a script counts, even when no code does.
						</p>
					</div>
				</article>
				<article>
					<span class="number">03</span>
					<div>
						<h2>Four rules on, the rest asked for</h2>
						<p>
							A project with no config gets prints, stray <code>pass</code>, orphaned
							<code>.gd.uid</code> files and tab indentation. Everything else stays quiet until
							<code>gdlint.json</code> switches it on, because the rest is house style and gdlint
							does not know yours yet.
						</p>
					</div>
				</article>
			</section>

			<section class="rules">
				<div class="section-head">
					<p class="eyebrow"><span></span> gdlint init</p>
					<h2>Every rule, and what it ships as.</h2>
					<p>
						<code>gdlint init</code> writes this list into <code>gdlint.json</code> with the defaults
						below. Errors block and exit non-zero; warnings only appear under <code>-warn</code>.
						Files can be excluded wholesale, or only from the unused-code rules, or only from the
						Variant rule.
					</p>
					<p class="aside">
						<code>-fix</code> acts on the errors — it deletes functions, signals, constants and whole
						files that static analysis believes are unused. Reflection, a string-built
						<code>call()</code> or a resource path assembled at runtime is invisible to it. Turn the
						unused rules on, read what they report, and keep the change reviewable.
					</p>
				</div>

				<table>
					<thead>
						<tr>
							<th scope="col">Rule</th>
							<th scope="col">Catches</th>
							<th scope="col">Default</th>
						</tr>
					</thead>
					<tbody>
						{
							rules.map((rule) => (
								<tr>
									<th scope="row">
										<code>{rule.key}</code>
										{rule.kind === 'warning' && <i>warning</i>}
									</th>
									<td>{rule.catches}</td>
									<td class={rule.on ? 'on' : 'off'}>{rule.on ? 'on' : 'off'}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<section class="closing">
				<p>Ship what you use.<br />Not what you wrote.</p>
				<div><span>PROJECT.GODOT</span><i></i><span>EVERY .GD AND .TSCN</span><i></i><span>WHAT NOTHING NEEDS</span></div>
				<div class="closing-actions">
					<a class="primary-cta light" href={repo}>Get gdlint <span class="icon" set:html={icon('arrow-right', 16)} /></a>
					<a class="ghost-cta" href={releases}>Download a binary <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
				</div>
			</section>
		</main>

		<footer>
			<a class="brand footer-brand" href="/"><span>gdlint</span></a>
			<p><a href={repo}>source</a> · <a href={releases}>releases</a> · by Avior Studio</p>
			<p>© {new Date().getFullYear()} gdlint</p>
		</footer>
	</div>
</Full>

<style>
	.page-shell { min-height: 100svh; overflow-x: hidden; }
	.site-header { width: min(1180px, calc(100% - 40px)); height: 76px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 19px; font-weight: 760; letter-spacing: -.03em; text-decoration: none; }
	.brand-mark { width: 27px; height: 27px; }
	.brand-mark path:first-child { fill: var(--ink); stroke: none; }
	.brand-mark path:last-child { fill: none; stroke: var(--blue); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
	.header-cta { display: inline-flex; align-items: center; color: var(--ink); border-bottom: 1px solid #c4cad0; padding: 6px 0; font-size: 13px; font-weight: 650; text-decoration: none; white-space: nowrap; }
	.header-cta span { margin-left: 5px; color: var(--blue-deep); }
	:global(.icon svg) { display: block; fill: currentColor; }

	.hero { width: min(1180px, calc(100% - 40px)); margin: 70px auto 110px; display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: 70px; }
	.hero-copy { position: relative; z-index: 2; }
	.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: var(--quiet); font: 620 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
	.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--blue-deep); box-shadow: 0 0 0 4px rgba(44, 100, 137, .13); }
	h1 { max-width: 600px; margin: 0; color: var(--ink); font-size: clamp(46px, 6vw, 78px); font-weight: 590; line-height: .98; letter-spacing: -.062em; }
	h1 em { color: var(--blue-deep); font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
	.lede { max-width: 520px; margin: 30px 0 32px; color: var(--quiet); font-size: 16px; line-height: 1.7; }
	.lede code { border-radius: 3px; background: #e3e7eb; padding: 1px 5px; color: #3c4650; font: 13px var(--mono); }
	.hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
	.install { display: block; max-width: 100%; overflow-x: auto; border: 1px solid #d3d8dd; border-radius: 5px; background: white; padding: 13px 16px; color: var(--ink); font: 500 12.5px/1 var(--mono); white-space: nowrap; }
	.hero-actions p { margin: 0; color: #858e96; font: 500 10px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .05em; }

	/* The run, as it prints. Text rather than a screenshot: it stays selectable,
	   it scales with the reader's font, and it cannot go blurry on a display the
	   screenshot was not taken for. The colours are the ANSI codes gdlint emits,
	   mapped one for one -- see README for the project and config it came from. */
	.product-frame { position: relative; min-width: 680px; border: 1px solid #d3d8dd; border-radius: 9px; background: white; box-shadow: 0 35px 80px rgba(20, 25, 31, .13), 0 3px 10px rgba(20, 25, 31, .07); overflow: hidden; transform: perspective(1400px) rotateY(-3deg) rotateX(1deg); }
	.product-frame::before { content: ''; position: absolute; z-index: -1; width: 340px; height: 340px; right: -70px; top: -90px; border-radius: 50%; background: var(--blue); filter: blur(80px); opacity: .32; }
	.frame-bar { height: 42px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e6eaee; padding: 0 13px; color: #525b64; font: 600 10px var(--mono); }
	.frame-brand, .frame-actions { display: flex; align-items: center; gap: 11px; }
	.menu-lines { width: 13px; height: 8px; border-block: 1px solid #757e86; position: relative; }
	.menu-lines::after { content: ''; position: absolute; left: 0; right: 0; top: 3px; border-top: 1px solid #757e86; }
	.frame-actions span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 4px; background: #eff2f5; color: #424a51; }

	.term { background: #0c1013; padding: 18px 20px; overflow-x: auto; }
	.term pre { width: max-content; margin: 0; color: #d5dade; font: 11.5px/1.72 var(--mono); }
	.term b { color: white; font-weight: 700; }
	.term .cmd { color: #78838c; }
	.term .head-err { color: #ff6b6b; font-weight: 700; }
	.term .head-warn { color: #ffd43b; font-weight: 700; }
	.term .head-sum { color: #66d9e8; font-weight: 700; }
	.term .err { color: #ff6b6b; }
	.term .warn { color: #ffd43b; }
	.term .loc { color: #7a838b; }
	/* The strip scrolls with the terminal above it rather than wrapping: broken
	   across two lines, "exit" and "1" end up on different rows and the pairing
	   that makes the strip readable is what breaks first. */
	.frame-keys { height: 34px; display: flex; align-items: center; gap: 9px; border-top: 1px solid #1b2126; background: #0c1013; padding: 0 20px; color: #6d767d; font: 9.5px var(--mono); white-space: nowrap; overflow-x: auto; }
	.frame-keys span { flex: none; color: var(--blue); font-weight: 500; }
	.frame-keys i { flex: none; width: 3px; height: 3px; border-radius: 50%; background: #333b41; }

	.principles { width: min(1180px, calc(100% - 40px)); margin: 0 auto 120px; border-top: 1px solid #d6dbe0; }
	.principles article { display: grid; grid-template-columns: 90px 1fr; border-bottom: 1px solid #d6dbe0; padding: 32px 0; }
	.principles article div { display: grid; grid-template-columns: .75fr 1fr; align-items: baseline; gap: 40px; }
	.number { color: var(--blue-deep); font: 650 10px var(--mono); }
	.principles h2 { margin: 0; color: var(--ink); font-size: 22px; font-weight: 580; letter-spacing: -.035em; }
	.principles p { max-width: 560px; margin: 0; color: var(--quiet); font-size: 14px; line-height: 1.65; }
	.principles code { border-radius: 3px; background: #e3e7eb; padding: 1px 5px; font: 12px var(--mono); }

	.rules { width: min(1180px, calc(100% - 40px)); margin: 0 auto 110px; display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: 60px; }
	.section-head h2 { margin: 0 0 22px; color: var(--ink); font-size: clamp(30px, 3.6vw, 42px); font-weight: 560; line-height: 1.03; letter-spacing: -.05em; }
	.section-head p { margin: 0 0 14px; max-width: 460px; color: var(--quiet); font-size: 15px; line-height: 1.7; }
	.section-head .aside { color: #79838b; font-size: 13.5px; }
	.section-head code { border-radius: 3px; background: #e3e7eb; padding: 1px 5px; font: 12px var(--mono); }

	.rules table { width: 100%; border-collapse: collapse; }
	.rules th, .rules td { text-align: left; border-bottom: 1px solid #d6dbe0; padding: 12px 12px 12px 0; font-size: 13px; font-weight: 500; vertical-align: baseline; }
	.rules thead th { color: var(--quiet); font: 650 9px var(--mono); letter-spacing: .09em; text-transform: uppercase; padding-bottom: 10px; }
	.rules tbody th code { color: var(--ink); font: 600 12px var(--mono); }
	/* The level rides in the rule cell rather than a column of its own. Only two
	   of the sixteen are warnings, so a fourth column would be blank fourteen
	   times over -- and it is the column a narrow screen would have dropped. */
	.rules tbody th i { display: inline-block; margin-left: 7px; border-radius: 3px; background: #ece4cd; color: #7d5f0e; padding: 2px 5px; font: 600 9px var(--mono); font-style: normal; letter-spacing: .06em; text-transform: uppercase; vertical-align: 1px; }
	.rules tbody td { color: var(--quiet); }
	.rules td.on, .rules td.off { font: 600 10px var(--mono); text-transform: uppercase; letter-spacing: .06em; }
	.rules td.on { color: var(--blue-deep); }
	.rules td.off { color: #99a1a8; }

	.closing { width: min(1180px, calc(100% - 40px)); margin: 0 auto; border-radius: 8px; background: var(--ink); color: white; padding: 65px; }
	.closing > p { max-width: 680px; margin: 0 0 50px; font-size: clamp(42px, 6vw, 72px); font-weight: 530; line-height: .98; letter-spacing: -.055em; }
	.closing > div { display: flex; align-items: center; gap: 13px; margin-bottom: 35px; color: #98a1a9; font: 560 9px var(--mono); letter-spacing: .09em; }
	.closing > div i { width: 50px; border-top: 1px dashed #545c63; }
	.closing-actions { display: flex; align-items: center; gap: 22px; }
	.closing-actions i { display: none; }
	.primary-cta { display: inline-flex; align-items: center; gap: 30px; border-radius: 4px; background: var(--ink); color: white; padding: 14px 18px; font-size: 13px; font-weight: 680; text-decoration: none; transition: transform .18s ease, background .18s ease; }
	.primary-cta:hover { transform: translateY(-2px); }
	.primary-cta.light { background: var(--blue); color: #0a1720; }
	.primary-cta.light span { color: #0a1720; }
	.ghost-cta { color: #c7cdd2; border-bottom: 1px solid #3a4249; padding: 6px 0; font-size: 13px; font-weight: 650; text-decoration: none; }
	.ghost-cta span { margin-left: 5px; color: var(--blue); }

	footer { width: min(1180px, calc(100% - 40px)); min-height: 120px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; color: #858e96; font: 500 10px var(--mono); }
	footer p { margin: 0; }
	footer p:nth-child(2) { text-align: center; }
	footer p:last-child { text-align: right; }
	footer a { color: #858e96; text-decoration: none; border-bottom: 1px solid #ccd1d6; }
	footer a:hover { color: var(--ink); }
	/* Needs to outrank `footer a` on the underline, and needs justify-self: the
	   brand is inline-flex, but a grid item stretches to its column and the
	   underline would run the full width of a cell the word does not fill. */
	footer a.footer-brand { justify-self: start; border: 0; color: var(--ink); font-family: var(--sans); font-size: 16px; }

	@media (max-width: 980px) {
		.hero { grid-template-columns: 1fr; margin-top: 45px; gap: 60px; }
		.hero-copy { max-width: 680px; }
		.product-frame { min-width: 0; width: 100%; transform: none; }
		.principles article div { grid-template-columns: 1fr; gap: 9px; }
		.rules { grid-template-columns: 1fr; gap: 32px; }
		.section-head p { max-width: 680px; }
	}
	@media (max-width: 600px) {
		.site-header, .hero, .principles, .rules, .closing, footer { width: min(100% - 28px, 1180px); }
		.site-header { height: 64px; }
		.hero { margin: 48px auto 80px; }
		.eyebrow { margin-bottom: 18px; }
		h1 { font-size: clamp(40px, 12.5vw, 58px); }
		.lede { margin-top: 24px; font-size: 15px; }
		.install { font-size: 11px; padding: 11px 13px; }
		.product-frame { border-radius: 6px; }
		.term { padding: 14px; }
		.term pre { font-size: 8.5px; line-height: 1.75; }
		.frame-keys { padding: 0 14px; font-size: 8.5px; }
		.principles article { grid-template-columns: 42px 1fr; padding: 26px 0; }
		.principles h2 { font-size: 19px; }
		.principles p { font-size: 13px; }
		.rules th, .rules td { font-size: 12px; padding-right: 8px; }
		.rules tbody th code { font-size: 11px; }
		.rules tbody th i { display: block; margin: 4px 0 0; }
		.closing { padding: 40px 25px; }
		.closing > div { flex-wrap: wrap; }
		.closing > div i { width: 20px; }
		.closing-actions { flex-direction: column; align-items: flex-start; gap: 16px; }
		footer { grid-template-columns: 1fr auto; padding: 30px 0; gap: 8px 0; }
		.footer-brand { display: none; }
		footer p:nth-child(2) { text-align: left; }
	}
</style>
